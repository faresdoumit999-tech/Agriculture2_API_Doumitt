# ---------------------------------------------------------------------------
# DOUMITT Agricultural ERP - environment template
# Copy to .env and replace every placeholder value. Never commit .env.
# ---------------------------------------------------------------------------

APP_NAME="DOUMITT Agricultural ERP"
ENVIRONMENT=development
DEBUG=false

# Mandatory: at least 16 characters. Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL 15. Neon/Railway/Back4App URLs are normalised automatically.
DATABASE_URL=postgresql+asyncpg://doumitt:doumitt@db:5432/doumitt

# Redis powers the report cache and Celery.
REDIS_URL=redis://redis:6379/0

# Report caching
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

# Rate limiting (use redis://redis:6379/1 in production for shared storage)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT=5/minute
REPORT_RATE_LIMIT=20/minute

# Optional Sentry observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# docker-compose PostgreSQL credentials (used by the db service)
POSTGRES_USER=doumitt
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=doumitt
